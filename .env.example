NODE_ENV=development
PORT=8080

# LeveLab Supabase/PostgreSQL — never commit real credentials.
DATABASE_URL=postgresql://postgres.sxdlfycpuipiewltnwhb:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.sxdlfycpuipiewltnwhb:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Public project URL (safe to document).
SUPABASE_URL=https://sxdlfycpuipiewltnwhb.supabase.co

# Server-only secrets.
SUPABASE_SECRET_KEY=
ATENDIMENTO_AGENT_BASE_URL=https://api.atendimento.center/api/v1
ATENDIMENTO_SERVICE_TOKEN=
# LIA Core -> backend (GET /api/v1/lia/context/:memberId). Same value as LEVELAB_API_TOKEN in levelab-lia.
LIA_API_TOKEN=
# Website server -> backend public forms (newsletter). Same value as WEB_FORMS_TOKEN in Vercel.
WEB_FORMS_TOKEN=

# Operator API (x-admin-token) for manual access grants.
ADMIN_API_TOKEN=

# Directory with the full premium PDFs inside the container.
CONTENT_DIR=/content

# Allowed browser origins, comma-separated.
CORS_ORIGINS=http://localhost:3000,https://levelab.org,https://app.levelab.org,https://lia.doctor

# ARO — only payment/entitlement integration (no provider-specific secrets).
ARO_API_URL=https://aro-preview.atlashub.si
ARO_PROJECT_SLUG=levelab
ARO_SERVER_KEY=
ARO_WEBHOOK_SECRET=
# Enable only after ARO project/offer mapping and end-to-end staging tests.
ARO_ENTITLEMENTS_ENABLED=false
